{
  "files.associations": {
    "*.mdx": "markdown"
  },
  "tailwindCSS.experimental.configFile": "src/styles/main.css",
  "task.allowAutomaticTasks": true,
  "debug.openDebug": "neverOpen",
  "terminal.integrated.inheritEnv": false,
  "tasks": {
    "label": "lint on open",
    "type": "shell",
    "command": "npm run lint",
    "runOn": "folderOpen"
  }
}
